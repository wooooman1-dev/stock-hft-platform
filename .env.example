PORT=8787
CLIENT_ORIGIN=http://localhost:5173
MARKET_MODE=simulation
DEFAULT_SYMBOL=005930
DEFAULT_SYMBOL_NAME=삼성전자
DEFAULT_PRICE=70000

# Internal SIMULATION paper-trading cost model (reference estimates only —
# verify against your actual brokerage fee schedule and current tax rates).
PULSEHFT_PAPER_BUY_COMMISSION_BPS=1.40527
PULSEHFT_PAPER_SELL_COMMISSION_BPS=1.40527
PULSEHFT_PAPER_SELL_TAX_BPS=20
PULSEHFT_PAPER_SLIPPAGE_TICKS=1

# KIS production REST quote-only mode.
# Production credentials must never be reused for paper trading.
PULSEHFT_KIS_MODE=DISABLED
PULSEHFT_KIS_APP_KEY=replace-with-your-production-app-key
PULSEHFT_KIS_APP_SECRET=replace-with-your-production-app-secret

# KIS paper account mode. Keep DISABLED until separate paper credentials and
# a paper account number have been issued. Never commit the real .env file.
PULSEHFT_KIS_PAPER_MODE=DISABLED
PULSEHFT_KIS_PAPER_APP_KEY=replace-with-your-paper-app-key
PULSEHFT_KIS_PAPER_APP_SECRET=replace-with-your-paper-app-secret
PULSEHFT_KIS_PAPER_ACCOUNT_NUMBER=replace-with-8-digit-paper-account
PULSEHFT_KIS_PAPER_ACCOUNT_PRODUCT_CODE=01

# Conservative paper-order safety limits.
PULSEHFT_KIS_PAPER_MAX_ORDER_QUANTITY=100
PULSEHFT_KIS_PAPER_MAX_ORDER_VALUE=1000000
PULSEHFT_KIS_PAPER_MAX_DAILY_ORDERS=200
PULSEHFT_KIS_PAPER_MAX_DAILY_LOSS=2000000

# KIS LIVE_TRADING canary — real money. Keep DISABLED until the user has
# explicitly approved live trading and issued separate live-order credentials.
# See docs/KIS_LIVE_TRADING.md before enabling any of this.
PULSEHFT_KIS_LIVE_MODE=DISABLED
PULSEHFT_KIS_LIVE_APP_KEY=replace-with-your-live-order-app-key
PULSEHFT_KIS_LIVE_APP_SECRET=replace-with-your-live-order-app-secret
PULSEHFT_KIS_LIVE_ACCOUNT_NUMBER=replace-with-8-digit-live-account
PULSEHFT_KIS_LIVE_ACCOUNT_PRODUCT_CODE=01

# Second, independent gate: LIVE_MODE alone only allows balance/status reads.
# This must also be true before any real order can be submitted.
# 기본값 false. KIS는 계좌마다 App Key를 발급하므로 시세용 계좌와 주문용 계좌를 나누는 것이
# 원래 설계다. 실전 계좌가 하나뿐이라 분리가 불가능할 때만 true로 옵트인한다.
# true로 켜면 시세 조회와 주문 제출이 같은 자격정보를 쓰게 되며, 기동 경고와
# LIVE_SHARED_QUOTE_CREDENTIAL_ENABLED 저널 이벤트가 남는다.
PULSEHFT_KIS_LIVE_ALLOW_SHARED_QUOTE_CREDENTIAL=false
PULSEHFT_KIS_LIVE_ORDER_ENABLED=false

# Third, independent gate: live AUTO-trading (the same strategy as paper). Needs
# LIVE_MODE + ORDER_ENABLED too. Off by default; it always starts switched off at
# server start and is turned on from the "실전투자" tab. When true, the limit
# defaults below change to the small-trial values (1000 shares / 200000 KRW per
# order, 30 orders/day, 50000 KRW daily loss, 3 consecutive losses). See
# docs/KIS_LIVE_TRADING.md.
PULSEHFT_KIS_LIVE_AUTO_TRADING_ENABLED=false

# Safety limits (override the defaults; manual orders are always exactly 1 share
# regardless of MAX_ORDER_QUANTITY, which only applies to auto-trading orders).
# These must be re-tuned to the account's actual capital.
PULSEHFT_KIS_LIVE_MAX_ORDER_QUANTITY=1
PULSEHFT_KIS_LIVE_MAX_ORDER_VALUE=2000000
PULSEHFT_KIS_LIVE_MAX_DAILY_ORDERS=5
PULSEHFT_KIS_LIVE_MAX_DAILY_LOSS=20000
PULSEHFT_KIS_LIVE_MAX_CONSECUTIVE_LOSSES=2

# ==========================================================
# 모의계좌 자동매매 (docs/AUTO_TRADING_PAPER_DESIGN.md)
# 아래는 전부 기본값이며, 지정하지 않으면 이 값이 적용된다.
# 실전 주문 경로와는 무관하다 — 모의계좌에만 작동한다.
# ==========================================================
# 자동매매 on/off. 기본 false — 켜야만 주문이 나간다.
PULSEHFT_AUTO_TRADING_ENABLED=false
# 비용을 모두 뺀 뒤에도 남아야 하는 최소 기대 순익(bp)
PULSEHFT_AUTO_TRADING_MIN_NET_EDGE_BPS=50
# 자기자본 대비 1회 진입 비중(0 초과 1 이하). 실제 수량은 모의계좌 한도로 다시 잘린다.
PULSEHFT_AUTO_TRADING_POSITION_SIZE_RATIO=0.1
PULSEHFT_AUTO_TRADING_ENTRY_MIN_CONFIDENCE=50
PULSEHFT_AUTO_TRADING_EXIT_MIN_CONFIDENCE=50
PULSEHFT_AUTO_TRADING_MAX_SPREAD_TICKS=2
PULSEHFT_AUTO_TRADING_COOLDOWN_MS=5000
# 진입 필터(2026-10-02). 체결강도·VWAP 괴리는 비우면 보지 않는다.
PULSEHFT_AUTO_TRADING_ENTRY_MIN_EXECUTION_STRENGTH=100
PULSEHFT_AUTO_TRADING_ENTRY_MIN_VWAP_EXTENSION_BPS=-50
# ENTRY_READY가 이 시간 이상 연속 유지돼야 진입한다.
PULSEHFT_AUTO_TRADING_ENTRY_CONFIRM_MS=30000
# 신규 진입 금지 시간대(KST, 쉼표로 구분). 청산은 계속한다.
PULSEHFT_AUTO_TRADING_NO_ENTRY_WINDOWS=09:00-09:10,11:30-13:00,14:50-15:30
# 손절폭이 이 틱 수보다 좁은 종목은 진입하지 않는다.
PULSEHFT_AUTO_TRADING_MIN_STOP_TICKS=6
# (익절-비용-스프레드)/(손절+비용+스프레드) 최소값
PULSEHFT_AUTO_TRADING_MIN_REWARD_RISK_RATIO=1.5
# 오늘 비용 차감 후 손실이 이 횟수 연속되면 그날 신규 진입을 멈춘다(0=끔).
PULSEHFT_AUTO_TRADING_MAX_CONSECUTIVE_LOSSES_PER_DAY=3
# 보호 청산(bp). 비우면 해당 청산을 쓰지 않는다.
PULSEHFT_AUTO_TRADING_STOP_LOSS_BPS=100
PULSEHFT_AUTO_TRADING_TAKE_PROFIT_BPS=250
# 손절선 아래에 이 시간만큼 머물러야 손절한다(손절폭 2배 이상 빠지면 즉시).
PULSEHFT_AUTO_TRADING_STOP_CONFIRM_MS=2000
PULSEHFT_AUTO_TRADING_TRAILING_STOP_BPS=70
PULSEHFT_AUTO_TRADING_MAX_HOLDING_MS=1800000
# 장 종료 전 강제 청산 시각(KST, HH:MM). 비우면 강제 청산하지 않는다.
PULSEHFT_AUTO_TRADING_FORCED_EXIT_TIME=15:15
# 호가·체결이 이보다 오래되면 신규 진입을 막는다. 보호 청산은 계속 동작한다.
PULSEHFT_AUTO_TRADING_STALE_QUOTE_MS=5000
# 평가 주기. 추천 스캐너 캐시 TTL과 맞춘다.
PULSEHFT_AUTO_TRADING_EVALUATION_INTERVAL_MS=15000
# 주문 후 잔고 반영을 기다리는 시간. 이 구간에는 "보유 없음"을 믿지 않는다.
PULSEHFT_AUTO_TRADING_SETTLEMENT_GRACE_MS=60000
# 주문 상태 불확실·대사 불일치 시 자동매매 중단
PULSEHFT_AUTO_TRADING_HALT_ON_UNKNOWN=true
PULSEHFT_AUTO_TRADING_HALT_ON_MISMATCH=true

# LS증권 Open API 시세(server/brokers/ls). docs/LS_OPEN_API_SETUP.md 참고.
# 위 MARKET_MODE를 ls로 바꾸면 메인 화면 시세가 LS증권 실시간 시세로 바뀝니다(계좌·주문은 계속 KIS).
# paper: 모의투자 WebSocket(29443) / live: 운영 WebSocket(9443). 주문은 항상 내부 모의체결입니다.
LS_ENVIRONMENT=paper
LS_MARKET=KOSPI
LS_APP_KEY=
LS_APP_SECRET=
